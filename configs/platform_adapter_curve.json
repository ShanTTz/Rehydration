{
  "platform": "HackerNews",
  "minimum_cascades": 5000,
  "split_fractions": {
    "train": 0.6,
    "validation": 0.2,
    "test": 0.2
  },
  "validation_budgets": [0, 10, 50, 250, 1000],
  "adapter_grid": {
    "ranking": ["top", "best", "hot"],
    "viewport_k": [10, 20, -1],
    "deep_drill_lambda": [0.0, 0.5, 1.0]
  },
  "selection": {
    "metrics": [
      "max_depth",
      "mean_leaf_depth",
      "mean_branching_factor",
      "root_reply_share",
      "width_gini",
      "time_to_90_minutes"
    ],
    "seed": 30371
  },
  "test": {
    "seeds": [0],
    "bootstrap_samples": 400,
    "max_test_cascades": 0
  },
  "reuse": {
    "enabled": true,
    "primary_budget": 250,
    "source_output": "artifacts/external_validation/platform_adapter"
  },
  "resume": true,
  "inputs": {
    "external_metrics": "artifacts/external_validation/cross_platform/external_cascade_metrics.parquet",
    "external_events": "artifacts/external_validation/cross_platform/hackernews_events.parquet",
    "reddit_metrics": "artifacts/data_audit/empirical_cascade_metrics.parquet",
    "simulation_config": "configs/revision_experiment.json"
  },
  "evidence_scope": {
    "allowed_claim": "BDMTF platform mechanisms can be adapted to held-out Hacker News cascades with a bounded amount of target-platform validation data.",
    "forbidden_claim": "Universal zero-shot transfer, causal intervention validity, or transfer beyond threaded discussion platforms.",
    "selection_rule": "All candidate choices are made on nested chronological validation subsets; the 1000-cascade test split is never used for selection."
  }
}
