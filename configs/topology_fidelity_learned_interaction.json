    "platform_operator": "best-to-controversial ranking only",
    "test_outcome_tuning": false
  },
  "analysis": {
    "bootstrap_samples": 5000,
    "cluster_unit": ["community", "post_id"],
    "scalar_nwd_support_threshold": 1.0,
    "depth_nwd_strong_threshold": 0.5,
    "depth_nwd_partial_threshold": 1.0,
    "positive_scaling": false
  }
