{
  "communities": ["AskReddit", "aww", "funny", "science", "worldnews"],
  "posts_per_community": 20,
  "seeds": [0, 1, 2],
  "trait_modes": [
    "coupled_original",
    "independent_marginal",
    "shuffled_marginal",
    "aggressive_constructive"
  ],
  "conditions": [
    {
      "name": "BASELINE",
      "core": "baseline",
      "ranking": "best",
      "context": "neutral"
    },
    {
      "name": "CORE_TOXIC_CONTROVERSIAL",
      "core": "toxic",
      "ranking": "controversial",
      "context": "neutral"
    }
  ],
  "simulation_config": "configs/reviewer_factorial.json",
  "randomization": {
    "seed_mode": "paired_by_post_seed_within_trait_mode",
    "unit": "community_post_seed_trait_mode"
  },
  "analysis": {
    "bootstrap_samples": 2000,
    "bootstrap_cluster": ["community", "post_id"],
    "primary_outcomes": ["log1p_comment_volume", "mean_leaf_depth"]
  },
  "evidence_scope": {
    "uses_legacy_paper_fit": true,
    "allowed_claim": "Trait-coupling robustness inside the exactly reproduced legacy simulator.",
    "forbidden_claim": "Independent real-world validation or empirical identification of personality traits."
  }
}
