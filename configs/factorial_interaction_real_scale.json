{
  "schema_version": 1,
  "seed": 30371,
  "bootstrap_samples": 2000,
  "inputs": {
    "factorial_runs": "run_outputs/reviewer_confirmatory_factorial/runs.jsonl",
    "empirical_metrics": "artifacts/data_audit/empirical_cascade_metrics.csv"
  },
  "factorial_cells": {
    "baseline_best": "BASELINE",
    "baseline_controversial": "BASELINE_CONTROVERSIAL",
    "conflict_best": "CORE_TOXIC_BEST",
    "conflict_controversial": "CORE_TOXIC_CONTROVERSIAL"
  },
  "real_scale_calibration": {
    "development_splits": ["train", "validation"],
    "test_split": "test",
    "formula": "community_scale = mean(real_leaf_depth_dev) / mean(simulated_baseline_leaf_depth_dev)",
    "application": "calibrated_depth = community_scale * simulated_depth",
    "fit_uses_test_outcomes": false,
    "fit_uses_intervention_outcomes": false
  },
  "evidence_scope": {
    "allowed_claim": "The controlled interaction remains interpretable after a development-fitted positive rescaling to the empirical Reddit depth range.",
    "forbidden_claim": "The rescaled counterfactual is an observed real-world treatment effect or independently validates Shallow Swarm causally."
  }
}
