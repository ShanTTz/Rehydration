{
  "protocol": {
    "name": "BDMTF real-intervention confirmation with trigger-adjusted calibration",
    "version": 2,
    "frozen_at": "2026-07-29T09:20:00Z",
    "amendment": {
      "reason": "Version 1 revealed that moderation follows a sharp pre-event activity trigger, violating the unconditional parallel-trends gate. Version 2 retains every pair and frozen outcome, but makes the pre-outcome calibrated estimator primary.",
      "version_1_artifact": "artifacts/interventions/natural_confirmatory_lemmy/natural_experiment_summary.json",
      "outcome_blind_rule": "Calibration weights use all 21 frozen pre-event trajectory features and never read post-event outcomes.",
      "reporting_rule": "Version 1 DiD failures remain reported as sensitivity evidence; version 2 cannot erase or replace them."
    },
    "analysis_principle": "The original BDMTF mechanism supplies directional hypotheses, but sample inclusion, calibration, diagnostics, and reporting do not depend on the observed effect sign.",
    "primary_hypotheses": [
      {
        "id": "H1_REPLY_ACTIVITY",
        "intervention": "Lemmy lock or removal",
        "outcome": "reply_count",
        "expected_direction": "negative"
      },
      {
        "id": "H2_ACTIVE_AUTHORS",
        "intervention": "Lemmy lock or removal",
        "outcome": "active_authors",
        "expected_direction": "negative"
      },
      {
        "id": "H3_DEPTH_GROWTH",
        "intervention": "Lemmy lock or removal",
        "outcome": "max_depth",
        "expected_direction": "negative"
      }
    ],
    "secondary_outcomes": [
      "removed_replies"
    ],
    "reporting_rule": "Report all frozen outcomes, intervals, diagnostics, null results, and opposite-direction estimates."
  },
  "tbbt": {
    "record_url": "https://zenodo.org/records/18245670",
    "raw_root": "data/external/tbbt/raw",
    "categories": [
      "ban",
      "post_removal",
      "quarantine",
      "migration"
    ],
    "license": "CC BY-NC-ND 4.0",
    "commit_raw_data": false,
    "role": "Full 38,700,732-message descriptive triangulation until independently matched untreated communities are supplied."
  },
  "lemmy": {
    "instances": [
      "https://lemmy.world"
    ],
    "output": "data/external/lemmy",
    "outcomes_output": "data/external/lemmy/outcomes_confirmatory",
    "pre_days": 7,
    "post_days": 7
  },
  "causal_analysis": {
    "panel_path": "data/external/lemmy/outcomes_confirmatory/lemmy_outcome_panel.parquet",
    "source_manifest_path": "data/external/lemmy/outcomes_confirmatory/outcome_collection_manifest.json",
    "output_name": "natural_confirmatory_lemmy_calibrated",
    "forecast_output_name": "forecast_confirmatory_lemmy",
    "bootstrap_samples": 2000,
    "seed": 30371,
    "r_script": "r/run_causal_analysis.R",
    "run_synthetic_control": false,
    "confirmatory": true,
    "primary_estimand": "ATT",
    "primary_estimator": "aggregate_preoutcome_calibrated_synthetic_control",
    "required_outcomes": [
      "reply_count",
      "active_authors",
      "max_depth"
    ],
    "aggregate_synthetic_control": {
      "enabled": true,
      "balance_outcomes": [
        "reply_count",
        "active_authors",
        "max_depth"
      ],
      "ridge": 0.1,
      "scale_floor": 0.1,
      "bootstrap_samples": 2000,
      "seed": 30371,
      "pretrend_threshold": 0.1
    },
    "claim_gates": {
      "require_source_status_complete": true,
      "minimum_matched_pairs": 100,
      "minimum_treated_overlap": 0.8,
      "require_no_pretrend_flag": true,
      "require_all_frozen_outcomes": true,
      "maximum_control_weight": 0.1,
      "minimum_effective_controls": 100,
      "maximum_standardized_pre_rmse": 0.1
    }
  }
