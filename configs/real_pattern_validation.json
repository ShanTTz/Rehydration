{
  "data": {
    "social_root": "data/social_paper",
    "splits": "artifacts/splits/post_splits.csv"
  },
  "window": {
    "early_cutoff_minutes": 60,
    "outcome_horizon_minutes": 720,
    "min_early_comments": 3,
    "min_late_comments": 3
  },
  "analysis": {
    "exposure": "early_toxicity_density",
    "bootstrap_samples": 2000,
    "seed": 30371,
    "primary_outcomes": {
      "log1p_late_comments": "positive",
      "late_mean_leaf_depth": "negative",
      "depth_growth": "negative",
      "late_root_reply_share": "positive"
    }
  },
  "evidence_scope": {
    "uses_paper_target_values": false,
    "fit_split": "train",
    "evaluation_split": "test",
    "claim": "Held-out observational pattern consistency, not causal identification.",
    "semantic_limit": "Lexicon flags are weak conflict proxies pending frozen model and human annotation."
  }
}
