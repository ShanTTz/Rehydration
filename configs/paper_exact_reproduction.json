{
  "communities": ["AskReddit", "aww", "funny", "science", "worldnews"],
  "posts_per_community": 100,
  "seeds": [0, 1, 2],
  "simulation": {
    "num_agents": 50,
    "steps": 72,
    "viewport_k": 5,
    "leader_fraction": 0.2,
    "base_impulse": 0.2,
    "alpha_conflict": 1.8,
    "beta_heat": 1.0,
    "gamma_consensus": 0.6,
    "polarity_kappa": 5.0,
    "threshold_base": 0.52,
    "noise_width": 0.1,
    "action_probability": 0.32,
    "action_probability_decay": 0.998,
    "baseline_action_multiplier": 0.90,
    "toxic_action_multiplier": 3.0,
    "toxic_activation_boost": 0.25,
    "toxic_reply_bonus": 0.04,
    "external_lambda": 80.0,
    "external_decay": 0.998,
    "max_external_reactions_per_step": 8000,
    "enable_external_traffic": true,
    "constructive_depth_lambda": 0.0,
    "antagonistic_depth_lambda": 3.5,
    "baseline_depth_lambda_floor": 0.0,
    "toxic_depth_lambda_floor": -100.0,
    "baseline_depth_fatigue_scale": 4.0,
    "toxic_depth_fatigue_scale": 6.0,
    "baseline_depth_collapse_start": 21.0,
    "toxic_depth_collapse_start": 13.0,
    "baseline_depth_collapse_relative_to_max": true,
    "toxic_depth_collapse_relative_to_max": false,
    "baseline_depth_collapse_scale": 0.2,
    "toxic_depth_collapse_scale": 0.5,
    "root_target_penalty": 0.005,
    "baseline_root_target_penalty": 0.05,
    "toxic_root_target_penalty": 0.005,
    "baseline_direct_root_reply_probability": 0.08,
    "toxic_direct_root_reply_probability": 0.0,
    "refresh_visibility_per_action": true,
    "visibility_refresh_interval_actions": 1,
    "baseline_max_comment_depth": 22,
    "toxic_max_comment_depth": 0,
    "baseline_max_comment_depth_jitter": 5,
    "toxic_max_comment_depth_jitter": 0
  },
  "community_calibration": {
    "AskReddit": {
      "threshold_base": 0.30,
      "early_engagement_median": 85572.5,
      "action_probability": 0.311,
      "toxic_reply_bonus": 0.09
    },
    "aww": {
      "threshold_base": 0.73,
      "early_engagement_median": 4363.5,
      "action_probability": 0.176,
      "toxic_action_multiplier": 2.5
    },
    "funny": {
      "threshold_base": 0.71,
      "early_engagement_median": 9112.0,
      "action_probability": 0.650,
      "toxic_reply_bonus": -0.03
    },
    "science": {
      "threshold_base": 0.52,
      "early_engagement_median": 10299.5,
      "action_probability": 0.238,
      "toxic_reply_bonus": 0.05
    },
    "worldnews": {
      "threshold_base": 0.48,
      "early_engagement_median": 26042.0,
      "action_probability": 0.293,
      "toxic_reply_bonus": 0.055
    }
  },
  "conditions": [
    {"name": "BASELINE", "core": "baseline", "ranking": "best", "context": "neutral"},
    {"name": "CORE_TOXIC_BEST", "core": "toxic", "ranking": "best", "context": "neutral"},
    {"name": "CORE_TOXIC_TOP", "core": "toxic", "ranking": "top", "context": "neutral"},
    {"name": "CORE_TOXIC_CONTROVERSIAL", "core": "toxic", "ranking": "controversial", "context": "neutral"},
    {"name": "CONTEXT_HOSTILE", "core": "baseline", "ranking": "best", "context": "hostile"},
    {"name": "CORE_HEALTHY_BEST", "core": "healthy", "ranking": "best", "context": "neutral"}
  ],
  "calibration_scope": {
    "label": "legacy_paper_fit",
    "uses_paper_table_targets": true,
    "purpose": "Reproduce the original submission before independent reviewer-driven validation."
  }
}
